-- ============ WALL CHECK ============
local function canSeeTarget(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit
    local ray = Ray.new(origin, direction * (targetPart.Position - origin).Magnitude)
    local hit = workspace:FindPartOnRay(ray, localPlayer.Character)
    if hit then
        local char = hit:FindFirstAncestorOfClass("Model")
        if char and char:FindFirstChild("Humanoid") then
            return true
        end
        return false
    end
    return true
end

-- ============ RANDOM HITBOX ============
local hitboxOptions = {"Head", "Torso", "HumanoidRootPart", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}
local randomHitbox = false

local function getRandomHitbox()
    return hitboxOptions[math.random(1, #hitboxOptions)]
end

-- ============ SILENT AIM ============
local phem4 = nil
local phem8 = nil
local phem7 = nil

local function removeCircle()
    if phem4 then
        phem4:Destroy()
        phem4 = nil
    end
end

local function aimmy()
    local success, module = pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        return require(ReplicatedStorage.Modules.Utility)
    end)

    if not success then
        warn("Silent aim module not found")
        return
    end

    phem7 = module
    phem8 = phem7.Raycast

    getgenv().Config = {
        HitPart = "Head",
        FOVRadius = fovradius,
        ShowFOV = showfovToggle
    }

    phem4 = Drawing.new("Circle")
    phem4.Visible = getgenv().Config.ShowFOV
    phem4.Radius = getgenv().Config.FOVRadius
    phem4.Color = Color3.fromRGB(255, 255, 255)
    phem4.Thickness = 1
    phem4.Filled = false

    RunService.RenderStepped:Connect(function()
        phem4.Position = Camera.ViewportSize / 2
        phem4.Radius = fovradius
        phem4.Visible = showfovToggle
    end)

    local function phem9()
        local phem10 = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local phem11 = nil
        local phem12 = fovradius
        local collection = game:GetService("CollectionService")

        for phem13, phem14 in collection:GetTagged("Entity") do
            if phem14 == localPlayer.Character then
                continue
            end

            local targetPart = phem14:FindFirstChild("Head", true)
            if randomHitbox then
                local randomPart = getRandomHitbox()
                targetPart = phem14:FindFirstChild(randomPart, true)
                if not targetPart then
                    targetPart = phem14:FindFirstChild("Head", true)
                end
            end

            if not targetPart or not targetPart:IsA("BasePart") then
                continue
            end

            if not canSeeTarget(targetPart) then continue end
            local phem16, phem17 = Camera:WorldToViewportPoint(targetPart.Position)
            if not phem17 then
                continue
            end
            local phem18 = (phem10 - Vector2.new(phem16.X, phem16.Y)).Magnitude
            if phem18 < phem12 then
                phem12 = phem18
                phem11 = targetPart
            end
        end
        return phem11
    end

    phem7.Raycast = function(self, phem19, phem20, phem21, phem22, phem23, phem24)
        if type(phem21) ~= "number" or phem21 < 100 then
            return phem8(self, phem19, phem20, phem21, phem22, phem23, phem24)
        end
        local phem25 = phem9()
        if not phem25 then
            return phem8(self, phem19, phem20, phem21, phem22, phem23, phem24)
        end
        local phem26 = phem25.Position
        local phem27 = (phem26 - phem19).Unit
        local phem28 = (phem26 - phem19).Magnitude
        if phem28 > phem21 then
            phem28 = phem21
            phem26 = phem19 + (phem27 * phem21)
        end
        return {
            Position = phem26,
            Distance = phem28,
            Instance = phem25,
            Material = phem25.Material,
            Normal = -phem27
        }
    end
end

-- ============ AIMBOT ============
local Aimbot = {}
Aimbot.running = false
Aimbot.connection = nil
Aimbot.smoothness = 8.0
Aimbot.fov = 80.0
Aimbot.triggerbot = true
Aimbot.wallCheck = true

local function getClosestPlayer()
    local closest = nil
    local closestFOV = Aimbot.fov

    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if not player.Character then continue end

        local hum = player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local targetPart = player.Character:FindFirstChild("Head")
        if randomHitbox then
            local randomPart = getRandomHitbox()
            targetPart = player.Character:FindFirstChild(randomPart)
            if not targetPart then
                targetPart = player.Character:FindFirstChild("Head")
            end
        end

        if not targetPart or not targetPart:IsA("BasePart") then continue end
        if Aimbot.wallCheck and not canSeeTarget(targetPart) then continue end

        local targetPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
        if not onScreen then continue end

        local screenCenter = Vector2.new(mouse.X, mouse.Y)
        local delta = Vector2.new(targetPos.X - screenCenter.X, targetPos.Y - screenCenter.Y)
        local fov = delta.Magnitude

        if fov < closestFOV then
            closestFOV = fov
            closest = {
                player = player,
                targetPos = targetPos,
                delta = delta
            }
        end
    end

    return closest
end

local function aimbotLoop()
    local target = getClosestPlayer()
    if not target then return end

    local delta = target.delta

    if delta.Magnitude < Aimbot.fov then
        local moveX = delta.X / Aimbot.smoothness
        local moveY = delta.Y / Aimbot.smoothness

        mouse_move(moveX, moveY)

        if Aimbot.triggerbot and delta.Magnitude < 3 then
            mouse1click()
        end
    end
end

function Aimbot:Start()
    if self.running then return end
    self.running = true
    self.connection = RunService.RenderStepped:Connect(aimbotLoop)
end

function Aimbot:Stop()
    if not self.running then return end
    self.running = false
    if self.connection then
        self.connection:Disconnect()
        self.connection = nil
    end
end

-- ============ TRIGGERBOT ============
local Triggerbot = {}
Triggerbot.running = false
Triggerbot.connection = nil
Triggerbot.enabled = true
Triggerbot.delayMin = 0.05
Triggerbot.delayMax = 0.15
Triggerbot.fireRate = 0.05
Triggerbot.teamCheck = true
Triggerbot.hitbox = "Any"
Triggerbot.wallCheck = true

local lastShot = 0
local targetLock = false

local function getTarget()
    local target = mouse.Target
    if not target then return nil end

    local player = nil
    if target:IsA("Model") then
        for _, char in ipairs(Players:GetPlayers()) do
            if char.Character == target then
                player = char
                break
            end
        end
    elseif target:IsA("BasePart") and target.Parent and target.Parent:IsA("Model") then
        local model = target.Parent
        for _, char in ipairs(Players:GetPlayers()) do
            if char.Character == model then
                player = char
                break
            end
        end
    end

    if not player or player == localPlayer then return nil end
    if Triggerbot.teamCheck and player.Team and player.Team == localPlayer.Team then return nil end

    local hum = player.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return nil end

    if Triggerbot.wallCheck then
        local targetPart = target:IsA("BasePart") and target or target:FindFirstChild("Head")
        if targetPart and targetPart:IsA("BasePart") and not canSeeTarget(targetPart) then return nil end
    end

    if Triggerbot.hitbox ~= "Any" then
        local targetPart = target:IsA("BasePart") and target or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
        if targetPart then
            local hitboxName = targetPart.Name
            if Triggerbot.hitbox == "Head" and hitboxName ~= "Head" then return nil end
            if Triggerbot.hitbox == "Torso" and hitboxName ~= "HumanoidRootPart" then return nil end
        end
    end

    return player
end

local function triggerLoop()
    if not Triggerbot.enabled then return end

    local now = tick()
    if now - lastShot < Triggerbot.fireRate then return end

    local target = getTarget()
    if not target then
        targetLock = false
        return
    end

    local reactionDelay = math.random() * (Triggerbot.delayMax - Triggerbot.delayMin) + Triggerbot.delayMin
    if not targetLock then
        targetLock = true
        task.wait(reactionDelay)
        if getTarget() ~= target then
            targetLock = false
            return
        end
    end

    mouse1click()
    lastShot = now
    targetLock = false
end

function Triggerbot:Start()
    if self.running then return end
    self.running = true
    self.connection = RunService.RenderStepped:Connect(triggerLoop)
end

function Triggerbot:Stop()
    if not self.running then return end
    self.running = false
    if self.connection then
        self.connection:Disconnect()
        self.connection = nil
    end
    targetLock = false
end

-- ============ GLOW ESP WITH NAME/HEALTH LABELS ============
local GlowESP = {}
GlowESP.running = false
GlowESP.connection = nil
GlowESP.glowColor = Color3.fromRGB(255, 0, 0)
GlowESP.glowObjects = {}
GlowESP.labelObjects = {}

local espShowNames = true
local espShowHealth = true

local function createLabels(player)
    local nameLabel = Drawing.new("Text")
    nameLabel.Text = player.Name
    nameLabel.Color = Color3.fromRGB(255, 255, 255)
    nameLabel.Size = 14
    nameLabel.Center = true
    nameLabel.Visible = true
    
    local healthLabel = Drawing.new("Text")
    healthLabel.Text = "100%"
    healthLabel.Color = Color3.fromRGB(0, 255, 0)
    healthLabel.Size = 12
    healthLabel.Center = true
    healthLabel.Visible = true
    
    GlowESP.labelObjects[player] = {
        name = nameLabel,
        health = healthLabel
    }
end

local function updateLabels()
    for player, labels in pairs(GlowESP.labelObjects) do
        if not player.Character then
            labels.name:Remove()
            labels.health:Remove()
            GlowESP.labelObjects[player] = nil
            continue
        end
        
        local head = player.Character:FindFirstChild("Head")
        local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
        
        if head and humanoid then
            local headScreenPos = Camera:WorldToScreenPoint(head.Position)
            
            if espShowNames then
                labels.name.Position = Vector2.new(headScreenPos.X, headScreenPos.Y - 25)
                labels.name.Text = player.Name
                labels.name.Visible = true
            else
                labels.name.Visible = false
            end
            
            if espShowHealth then
                local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
                labels.health.Position = Vector2.new(headScreenPos.X, headScreenPos.Y + 15)
                labels.health.Text = string.format("%.0f%%", healthPercent)
                
                local healthRatio = humanoid.Health / humanoid.MaxHealth
                labels.health.Color = Color3.fromRGB(255 * (1 - healthRatio), 255 * healthRatio, 0)
                labels.health.Visible = true
            else
                labels.health.Visible = false
            end
        else
            labels.name.Visible = false
            labels.health.Visible = false
        end
    end
end

local function createGlowESP(player)
    if not player.Character then return end
    local char = player.Character
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "GlowESP"
            highlight.Adornee = char
            highlight.FillColor = GlowESP.glowColor
            highlight.OutlineColor = GlowESP.glowColor
            highlight.FillTransparency = 0.3
            highlight.OutlineTransparency = 0
            highlight.Parent = part
            GlowESP.glowObjects[char] = highlight
            break
        end
    end
    createLabels(player)
end

local function removeGlowESP(char)
    if GlowESP.glowObjects[char] then
        GlowESP.glowObjects[char]:Destroy()
        GlowESP.glowObjects[char] = nil
    end
end

function GlowESP:Start()
    if self.running then return end
    self.running = true
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            createGlowESP(player)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= localPlayer then
            player.CharacterAdded:Connect(function()
                task.wait(0.1)
                createGlowESP(player)
            end)
        end
    end)
    
    self.connection = RunService.RenderStepped:Connect(updateLabels)
end

function GlowESP:Stop()
    if not self.running then return end
    self.running = false
    if self.connection then
        self.connection:Disconnect()
    end
    for char, _ in pairs(GlowESP.glowObjects) do
        removeGlowESP(char)
    end
    for _, labels in pairs(GlowESP.labelObjects) do
        labels.name:Remove()
        labels.health:Remove()
    end
    GlowESP.labelObjects = {}
end

-- ============ TRACERS ============
local Tracers = {}
Tracers.running = false
Tracers.connection = nil
Tracers.enabled = false
Tracers.color = Color3.fromRGB(255, 0, 0)
Tracers.thickness = 2
Tracers.tracerObjects = {}

local function updateTracers()
    for _, tracer in pairs(Tracers.tracerObjects) do
        tracer:Remove()
    end
    Tracers.tracerObjects = {}

    if not Tracers.enabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if not player.Character then continue end
        
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        
        local head = player.Character:FindFirstChild("Head")
        if not head then continue end
        
        local headPos = Camera:WorldToScreenPoint(head.Position)
        local screenCenter = Camera.ViewportSize / 2
        
        local tracer = Drawing.new("Line")
        tracer.From = Vector2.new(screenCenter.X, screenCenter.Y)
        tracer.To = Vector2.new(headPos.X, headPos.Y)
        tracer.Color = Tracers.color
        tracer.Thickness = Tracers.thickness
        tracer.Visible = true
        
        table.insert(Tracers.tracerObjects, tracer)
    end
end

function Tracers:Start()
    if self.running then return end
    self.running = true
    self.connection = RunService.RenderStepped:Connect(updateTracers)
end

function Tracers:Stop()
    if not self.running then return end
    self.running = false
    if self.connection then
        self.connection:Disconnect()
    end
    for _, tracer in pairs(Tracers.tracerObjects) do
        tracer:Remove()
    end
    Tracers.tracerObjects = {}
end

-- ============ NO SPREAD ============
local NoSpread = {}
NoSpread._originalFunc = nil
NoSpread._enabled = false

local function getGunModule()
    local people = game:GetService("Players")
    local success, module = pcall(function()
        return require(people.LocalPlayer.PlayerScripts.Modules.ItemTypes.Gun)
    end)
    if success and module then
        return module
    end
    return nil
end

function NoSpread:Start()
    if self._enabled then return end
    local gun = getGunModule()
    if not gun or not gun.IsFullyAiming then
        warn("Gun module not found")
        return
    end
    
    self._originalFunc = gun.IsFullyAiming
    self._enabled = true
    
    gun.IsFullyAiming = function(self, ...)
        return true
    end
    
    print("started")
end

function NoSpread:Stop()
    if not self._enabled then return end
    local gun = getGunModule()
    if gun and self._originalFunc then
        gun.IsFullyAiming = self._originalFunc
    end
    self._originalFunc = nil
    self._enabled = false
    print("stopped")
end

